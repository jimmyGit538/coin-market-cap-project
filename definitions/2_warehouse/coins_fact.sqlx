config {
    type: "table",
    tags: ["warehouse"],
    schema: "warehouse"
}

WITH
  cleaned AS (
  SELECT
    * EXCEPT(quote_date, category_id),
    quote_date AS date
  FROM
    ${ref("quotes_historical_30d_29_raw_V4")}
  WHERE
    coin_id != 23624
    AND NOT (coin_id = 34472
      AND DATE(quote_timestamp) BETWEEN '2025-06-01'
      AND '2025-06-12')
      --This ID is showing massive market cap for Dec 13th/14th which is clearly a data error.
      )
      /*
      -
      -
      */
  SELECT
    /*
    keys
    */
    coin_id AS cmc_id,
    /*
    metrics
    */
    market_cap,
    price,
    volume_24h,
    circulating_supply,
    total_supply,
    /*
    dates
    */
    date
  FROM
    cleaned
  QUALIFY
    ROW_NUMBER() OVER(PARTITION BY coin_id, date
    ORDER BY
      ingestion_timestamp_utc DESC) = 1
      --using this QUALIFY statement to only pull the most current coin data in the case of multiple data inserts in one 24hr period.
