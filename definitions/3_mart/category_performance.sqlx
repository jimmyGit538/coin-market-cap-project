config {
    type: "table",
    tags: ["mart"],
    bigquery: {
        partitionBy: "date",
        clusterBy: ["category_name"]
    },
    schema: "mart"
}

SELECT
  agg.date,
  cd.name as category_name,
  agg.num_tokens,
  agg.market_cap,
  agg.volume,
FROM
  ${ref("category_agg_fact")} agg
LEFT JOIN
  ${ref("category_dim")} cd
USING
  (category_id)
