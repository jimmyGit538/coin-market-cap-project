config {
    type: "table",
    tags: ["mart"],
    schema: "mart_staging"
}

  /*
  CLEANING NOTES
  -
  -
  To avoid duplicate category names, using this table to consolidate categories where necessary.
  For example, RAW data contains 'Privacy', 'Privacy Coin', and 'Privacy Blockchain'.
  These are being consolidated into 'Privacy'.
  -
  -
  There are many coins assigned to multiple categories, making categorical analysis very challenging downstream.
  Where applicable, reassigning categories.
  */
  /*
  -
  -
  -
  ID mapping query
  Maps new ids from 'map_category_id' to their newly created IDs.
  */
WITH
  map AS (
  SELECT
    DISTINCT
    /*
    keys
    */
    mc.category_id_new AS category_id,
    /*
    dimensions
    */
    CASE
      WHEN mc.category_id_new ='11111' THEN 'Privacy'
      WHEN mc.category_id_new ='22222' THEN 'Stablecoins'
      ELSE name
  END
    AS name,
    /*
    -
    */
    CASE
      WHEN mc.category_id_new ='11111' THEN 'Privacy'
      WHEN mc.category_id_new ='22222' THEN 'Stablecoins'
      ELSE title
  END
    AS title,
    CASE
      WHEN mc.category_id_new ='11111' THEN 'Privacy'
      WHEN mc.category_id_new ='22222' THEN 'Stablecoins'
      ELSE description
  END
    AS description
  FROM
    ${ref("warehouse", "category_dim")} cd
  LEFT JOIN
    ${ref("mart_staging", "map_category_id")} mc
  USING
    (category_id) )
    /*
    -
    -
    -
    */
SELECT
  DISTINCT * EXCEPT(name)
  CASE
    WHEN name IN ('DeFi', 'DeSci', 'DeFAI', 'DePIN', 'IoT', 'Privacy' ) THEN "Industry"
    WHEN name IN ('Move To Earn',
    'Memes',
    'Storage',
    'Lending & Borrowing',
    'Gambling',
    'Music',
    'Stablecoins',
    'Tokenized Assets',
    'Insurance',
    'NFTs & Collectibles',
    'Sports',
    'Gaming') THEN 'Sector'
    WHEN name IN ( 'Quantum-Resistant', 'Zero Knowledge Proofs', "AI Agents", 'AI & Big Data') THEN "Function"
    WHEN category_name IN('Oracles',
    'Layer 1',
    'Layer 2') THEN 'Infrastructure'
END
  AS label
FROM
  map
