config {
    type: "table",
    tags: ["mart"],
    schema: "mart_staging"
}

  /*
  distinct is required to eliminate dups for any categories that were remapped in upstream map_category_ids
  */
SELECT
  /*
  keys
  */
  DISTINCT cmc_id,
  category_id_new AS category_id
FROM
  ${ref("mart_staging", "map_category_id")}
